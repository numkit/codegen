/* Generated by CMake (configure_file). Absolute, forward-slashed
 * (CMake-normalised) paths used by the codegen bridge/plugin/tiered tests —
 * valid C string literals; LoadLibraryA/dlopen and cl.exe accept them. */
#ifndef NUMKIT_CODEGEN_TEST_PATHS_H
#define NUMKIT_CODEGEN_TEST_PATHS_H

/* The prebuilt sample plugin shared library (Plugin.LoadSharedLibraryAndCall). */
#define NUMKIT_SAMPLE_PLUGIN_PATH "@NUMKIT_SAMPLE_PLUGIN_FILE@"

/* The bridge header directory, so a generated plugin TU can
 * #include "<NUMKIT_BRIDGE_DIR>/numkit_plugin.h" without an -I flag (CodegenTiered). */
#define NUMKIT_BRIDGE_DIR "@NUMKIT_BRIDGE_DIR@"

/* The numkit_codegen_rt shared lib (DESIGN.md §6a brick 3): import lib to LINK a
 * bridged artifact against, and the runtime DLL to copy beside it (CodegenBridge). */
#define NUMKIT_RT_IMPORT_LIB "@NUMKIT_RT_IMPORT_LIB@"
#define NUMKIT_RT_SHARED_DLL "@NUMKIT_RT_SHARED_DLL@"

/* The numkit_ops_kernels shared lib (ops-kernel lowering tier): the ops include dir
 * (so a generated TU resolves <numkit/ops/kernels.hpp>), the import lib to LINK
 * an ops-using artifact against, and the DLL to copy beside it (CodegenOpsKernel). */
#define NUMKIT_OPS_INCLUDE_DIR "@NUMKIT_OPS_INCLUDE_DIR@"
#define NUMKIT_OPS_IMPORT_LIB  "@NUMKIT_OPS_IMPORT_LIB@"
#define NUMKIT_OPS_SHARED_DLL  "@NUMKIT_OPS_SHARED_DLL@"

#endif
